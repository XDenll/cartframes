{
  "schemaVersion": 1,
  "id": "cartframes",
  "version": "${version}",
  "name": "CartFrames",
  "description": "Adds a clean, customizable HUD overlay displaying real-time minecart speed, velocity vectors, and block alignment stats.",
  "authors": [
    "XDenll"
  ],
  "contact": {
    "sources": "https://github.com/yourname/cartframes",
    "issues": "https://github.com/yourname/cartframes/issues"
  },
  "license": "MIT",
  "icon": "assets/cartframes/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.cartframes.CartFramesClient"
    ],
    "modmenu": [
      "dev.cartframes.config.CartFramesModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/jEGF5fb"
      },
      "update_checker": true
    }
  }
}